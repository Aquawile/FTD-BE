# GCP configuration
GCP_PROJECT=ftd2026
GCE_INSTANCE_NAME=data-ingest-vm
GCE_ZONE=us-west2-a

# Storage
GCS_BUCKET=raw-data-strg
GCS_SEC_PREFIX=SEC

# SEC EDGAR compliance (required)
SEC_USER_AGENT=FinanceTrackerDashboard izzybutera11@gmail.com

# Live SEC ticker→CIK map (cross-reference only)
COMPANY_TICKERS_URL=https://www.sec.gov/files/company_tickers.json

# Target ~500 companies — JSON in GCS (auto-bootstrapped from fallback if missing)
FORTUNE_500_GCS_PATH=config/fortune500.json
FORTUNE_500_FALLBACK_URL=https://raw.githubusercontent.com/datasets/s-and-p-500-companies/master/data/constituents.csv
TARGET_COMPANY_LIMIT=500

# Lookback: 7-day initial backfill, then 24-hour delta-scan
INITIAL_LOOKBACK_DAYS=7
STEADY_LOOKBACK_DAYS=1

USE_BULK_SUBMISSIONS=false
MAX_DOWNLOAD_GB=2.0
MAX_INGEST_GB=5.0
ALLOW_LOCAL_EXECUTION=false
